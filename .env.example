# Required environment variables for the Azizam bot + API (see deploy/README.md).
# The deployment reads these from a private env file on the server, never from Git.
# Copy the values from your laptop into /home/arian/azizam/shared/bot.env on the server over SSH.

# ---- Telegram ----
# Bot token from @BotFather, used by bot.py AND by api_server.py (HMAC validation).
BOT_TOKEN=123456789:AAreplace-me-with-your-real-token

# Optional extra bots accepted by the API (deprecated, keep only if you still use it).
BBH_MAIN_BOT_TOKEN=
MINI_BOT_TOKEN=

# ---- Admin access ----
# Comma-separated numeric Telegram user ids (get yours with /id in the bot).
MASTER_ADMIN_IDS=
# Comma-separated @usernames without the @.
MASTER_ADMIN_USERNAMES=

# ---- Database paths (inside the container) ----
# Persistent SQLite path mounted at /data (volume azizam_bot-data).
DB_PATH=/data/bot_data.db
SHARED_DB=/data/bot_data.db

# ---- HTTP API bind (compose supplies these; do not change unless the port is taken) ----
HOST=0.0.0.0
PORT=8080
API_HOST=0.0.0.0
API_PORT=8080

# ---- Default command trigger words (override with /setword in the bot) ----
DEFAULT_WARN_WORD=اخطار
DEFAULT_STRIKE_WORD=استرایک
DEFAULT_PLUS_WORD=امتیاز
