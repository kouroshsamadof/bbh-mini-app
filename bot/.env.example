# توکن ربات از @BotFather (دستور /newbot)
BOT_TOKEN=123456789:AAreplace-me-with-your-real-token

# ادمین‌های اصلی (همیشه و همه‌جا اجازه دارند) — آیدی عددی خودتان را با دستور /id از ربات بگیرید
# چند آیدی را با کاما جدا کنید، مثال: MASTER_ADMIN_IDS=111111111,222222222
MASTER_ADMIN_IDS=

# اختیاری: یوزرنیم ادمین‌های اصلی بدون @ (با کاما جدا کنید)
MASTER_ADMIN_USERNAMES=kouroshhsam

# مسیر فایل دیتابیس SQLite
DB_PATH=bot_data.db

# کلمات پیش‌فرض دستورات (بعداً داخل ربات با /setword تغییرشان می‌دهید)
DEFAULT_WARN_WORD=اخطار
DEFAULT_STRIKE_WORD=استرایک
DEFAULT_PLUS_WORD=امتیاز
